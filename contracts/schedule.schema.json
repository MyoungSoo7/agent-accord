{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "accord/schedule",
  "title": "일정 조율 — 후보 구간과 제약, 합의된 확정 구간",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "duration_min", "timezone", "candidates"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "duration_min": { "type": "integer" },
    "timezone": { "type": "string", "minLength": 1 },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start", "end"],
        "properties": {
          "start": { "type": "string", "minLength": 1 },
          "end": { "type": "string", "minLength": 1 },
          "note": { "type": "string" }
        }
      }
    },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "chosen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string" },
        "end": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
